# Dipendenze (ognuno le rigenera con `npm install`)
node_modules/

# Build / output generato (si rigenera con `npm run build`)
dist/
dist-ssr/
*.local

# Cache strumenti
.vite/
.cache/
node_modules/.cache/
.eslintcache

# Log
*.log
npm-debug.log*

# File di sistema OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?

# Schermate dello smoke test (si rigenerano con `npm run smoke`)
.smoke/

# Artefatti Lighthouse / spazzatura accidentale
C:\\Users\\*
lighthouse-report.html
lighthouse-report.json
lighthouse.*/
/tmp/
*.tmp

# Variabili d'ambiente (eventuali segreti)
.env
.env.*
!.env.example

# Cache Python degli script
__pycache__/
*.pyc

# App Android (TWA): si rigenera con scripts/android-twa.mjs. Nel repo solo la configurazione.
# La chiave di firma sta fuori dal repo, in ../mondomago-android-segreti/
/android/*
!/android/twa-manifest.json
*.jks
*.keystore
